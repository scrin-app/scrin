    <string name="a11y_service_label">scrin remote control</string>
    <string name="a11y_service_summary">Lets a helper you accepted tap and type during a scrin session.</string>
    <string name="a11y_service_description">Used only during a remote session you accepted: performs the taps, swipes, Back/Home/Recents and text entry sent by the person helping you. It is not an assistive tool, does not run outside a session, and stores nothing.</string>


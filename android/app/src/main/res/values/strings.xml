    <string name="disclosure_title">Remote control uses Accessibility</string>
    <string name="disclosure_what">scrin uses the Android Accessibility API only during a session you accept, to perform the taps, swipes, Back/Home actions and text entry your helper sends.</string>
    <string name="disclosure_data">It reads the focused text field only to type into it. Nothing it sees is stored, sent to scrin servers or used for anything else.</string>
    <string name="disclosure_not">It is not an assistive tool and never acts when no session is running.</string>
    <string name="disclosure_off">You can turn it off at any time in Settings › Accessibility › scrin remote control.</string>
    <string name="disclosure_agree">I agree, open settings</string>
    <string name="disclosure_decline">Not now</string>


    <string name="restricted_title">Allow restricted settings</string>
    <string name="restricted_body">On Android 13 and newer, apps installed outside a store can\'t turn on Accessibility services until you allow it once.</string>
    <string name="restricted_step1">Open Settings › Accessibility and tap scrin remote control once. Android shows “Restricted setting”. Tap OK.</string>
    <string name="restricted_step2">Open scrin\'s App info (button below).</string>
    <string name="restricted_step3">Tap the ⋮ menu in the top-right corner.</string>
    <string name="restricted_step4">Tap “Allow restricted settings” and confirm with your PIN or fingerprint.</string>
    <string name="restricted_step5">Go back to Accessibility and turn on scrin remote control.</string>
    <string name="restricted_open_app_info">Open App info</string>
    <string name="restricted_open_a11y">Open Accessibility settings</string>

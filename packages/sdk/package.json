{
  "name": "@scrin/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Typed TypeScript client for the scrin accounts API.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsdown",
    "generate": "node scripts/generate.mjs",
    "check:drift": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

            178
          ],
          "hex": "#0c1312"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral-dark.7}"
      },
      "focus": {
        "$value": "{color.lagoon-dark.9}"
      }
    },
    "accent": {
      "solid": {
        "$value": "{color.lagoon-dark.9}"
      },
      "solid-hover": {
        "$value": "{color.lagoon-dark.10}"
      },
      "text": {
        "$value": "{color.lagoon-dark.11}"
      },
      "subtle": {
        "$value": "{color.lagoon-dark.3}"
      }
    },
    "status": {
      "success": {
        "bg": {
          "$value": "{color.success-dark.3}"
        },
        "solid": {
          "$value": "{color.success-dark.9}"
        },
        "fg": {
          "$value": "{color.success-dark.11}"
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.warning-dark.3}"
        },
        "solid": {
          "$value": "{color.warning-dark.9}"
        },
        "fg": {
          "$value": "{color.warning-dark.11}"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.danger-dark.3}"
        },
        "solid": {
          "$value": "{color.danger-dark.9}"
        },
        "fg": {
          "$value": "{color.danger-dark.11}"
        }
      }
    }
  },
  "dark-amoled": {
    "$type": "color",
    "$description": "AMOLED surface mode: only bg.canvas changes; everything else inherits dark.",
    "bg": {
      "canvas": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            178
          ],
          "hex": "#000000"
        }
      }
    }
  }

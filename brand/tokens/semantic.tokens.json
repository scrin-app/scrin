    },
    "fg": {
      "default": {
        "$value": "{color.neutral-dark.12}"
      },
      "muted": {
        "$value": "{color.neutral-dark.11}"
      },
      "on-accent": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.18,

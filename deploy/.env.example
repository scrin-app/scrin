# Copy to deploy/.env and edit. Never commit deploy/.env.
SCRIN_DOMAIN=relay.example.org
SCRIN_ACME_CONTACT=mailto:ops@example.org
# true while testing (Let's Encrypt staging: untrusted certs, generous rate limits)
SCRIN_ACME_STAGING=false
# Per-session browser gateway cap, bytes/second (0 = unlimited)
SCRIN_GW_MAX_BPS=3000000
SCRIN_LOG=info
# SCRIN_IMAGE=europe-west3-docker.pkg.dev/<project>/scrin/scrin-server:<tag>

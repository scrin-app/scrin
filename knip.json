{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["scripts/**"],
  "ignoreIssues": {
    "pnpm-workspace.yaml": ["catalog"]
  },
  "workspaces": {
    "packages/i18n": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "scripts/*.mjs", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
